{
  "name": "obsidian-smf-export",
  "version": "0.1.0",
  "description": "Export a story to Standard Manuscript Format as a .docx",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "sample": "esbuild scripts/sample.ts --bundle --platform=node --format=cjs --outfile=.sample.cjs --log-level=warning && node .sample.cjs",
    "test": "esbuild tests/*.test.ts --bundle --platform=node --format=cjs --outdir=.tests --log-level=warning && node --test .tests/*.test.js",
    "lint": "eslint src",
    "install:vault": "npm run build && cp main.js \"${SMF_VAULT:-$HOME/Documents/Sync Vault}/.obsidian/plugins/standard-manuscript-format/main.js\" && echo '\\nCopied to the vault. Reload Obsidian to load it (the test vault is symlinked and needs no copy).'"
  },
  "keywords": [],
  "author": "Beth Dean",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/parser": "^8.66.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "obsidian": "latest",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "docx": "^9.1.1",
    "jszip": "^3.10.1"
  }
}
